[Unit]
Description=The Grid classes4 - replicate of classes1
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/etl/odin/thegrid-classes4
ExecStart=/home/etl/odin/thegrid-worktree/.venv/bin/python -m src.colony.live --host 0.0.0.0 --port 8833 --ticks-per-second 10 --mutator random --name "classes4" --features "predation,eviction,classes" --state /home/etl/.local/state/thegrid-classes4/colony.pkl
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/etl/odin/thegrid-classes4
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/etl/.local/state/thegrid-classes4
MemoryMax=1536M
MemoryHigh=1024M
MemorySwapMax=0
CPUQuota=100%
CPUWeight=100

[Install]
WantedBy=default.target
