[Unit]
Description=The Grid classes1 - program-class ecology (wizard/cleaner/predator/hog)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/etl/odin/thegrid-classes1
ExecStart=/home/etl/odin/thegrid-worktree/.venv/bin/python -m src.colony.live --host 0.0.0.0 --port 8830 --ticks-per-second 10 --mutator random --name "classes-1" --features "predation,eviction,classes" --state /home/etl/.local/state/thegrid-classes1/colony.pkl
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/etl/odin/thegrid-classes1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/etl/.local/state/thegrid-classes1
MemoryMax=1536M
MemoryHigh=1024M
MemorySwapMax=0
CPUQuota=100%
CPUWeight=100

[Install]
WantedBy=default.target
