[Unit]
Description=The Grid classes-builder - five classes incl builder (infrastructure niche)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/etl/odin/thegrid-classes-builder
ExecStart=/home/etl/odin/thegrid-worktree/.venv/bin/python -m src.colony.live --host 0.0.0.0 --port 8834 --ticks-per-second 10 --mutator random --name "classes-builder" --features "predation,eviction,classes" --state /home/etl/.local/state/thegrid-classes-builder/colony.pkl
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/etl/odin/thegrid-classes-builder
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/etl/.local/state/thegrid-classes-builder
MemoryMax=1536M
MemoryHigh=1024M
MemorySwapMax=0
CPUQuota=100%
CPUWeight=100

[Install]
WantedBy=default.target
