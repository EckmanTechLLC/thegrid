[Unit]
Description=The Grid classes2 - replicate of classes1
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/etl/odin/thegrid-classes2
ExecStart=/home/etl/odin/thegrid-worktree/.venv/bin/python -m src.colony.live --host 0.0.0.0 --port 8831 --ticks-per-second 10 --mutator random --name "classes2" --features "predation,eviction,classes" --state /home/etl/.local/state/thegrid-classes2/colony.pkl
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/etl/odin/thegrid-classes2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/etl/.local/state/thegrid-classes2
MemoryMax=1536M
MemoryHigh=1024M
MemorySwapMax=0
CPUQuota=100%
CPUWeight=100

[Install]
WantedBy=default.target
