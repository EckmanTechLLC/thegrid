[Unit]
Description=The Grid Colony Eight (explicit-operand netlist encoding)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/etl/odin/thegrid-colony8
ExecStart=/home/etl/odin/thegrid-worktree/.venv/bin/python -m src.colony.live --host 0.0.0.0 --port 8794 --ticks-per-second 10 --mutator random --name "Colony Eight" --features "" --state /home/etl/.local/state/thegrid-colony8/colony.pkl
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/etl/odin/thegrid-colony8
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/etl/.local/state/thegrid-colony8
MemoryMax=1536M
MemoryHigh=1024M
MemorySwapMax=0
CPUQuota=100%
CPUWeight=100

[Install]
WantedBy=default.target
