[Unit]
Description=The Grid colony three seeded-founder habitat
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/etl/odin/thegrid-colony3
ExecStart=/home/etl/odin/thegrid-worktree/.venv/bin/python -m src.colony.live --host 0.0.0.0 --port 8789 --ticks-per-second 10 --mutator random --peers "127.0.0.1:8787,127.0.0.1:8788,127.0.0.1:8790,127.0.0.1:8791,127.0.0.1:8792,127.0.0.1:8793" --state /home/etl/.local/state/thegrid-colony3/colony.pkl
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/etl/odin/thegrid-colony3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/etl/.local/state/thegrid-colony3
MemoryMax=4G
MemoryHigh=3G
MemorySwapMax=0
CPUQuota=100%
CPUWeight=100

[Install]
WantedBy=default.target
