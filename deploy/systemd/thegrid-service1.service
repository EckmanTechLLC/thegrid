[Unit]
Description=The Grid service1
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/etl/odin/thegrid-service1
ExecStart=/home/etl/odin/thegrid-worktree/.venv/bin/python -m src.colony.live --host 0.0.0.0 --port 8817 --ticks-per-second 10 --mutator random --name "service1" --features "predation,eviction,service" --state /home/etl/.local/state/thegrid-service1/colony.pkl
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/etl/odin/thegrid-service1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/etl/.local/state/thegrid-service1
MemoryMax=1536M
MemoryHigh=1024M
MemorySwapMax=0
CPUQuota=100%
CPUWeight=100

[Install]
WantedBy=default.target
