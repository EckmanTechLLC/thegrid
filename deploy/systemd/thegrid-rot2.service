[Unit]
Description=The Grid rot2
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/etl/odin/thegrid-rot2
ExecStart=/home/etl/odin/thegrid-worktree/.venv/bin/python -m src.colony.live --host 0.0.0.0 --port 8822 --ticks-per-second 10 --mutator random --name "rot2" --features "bitrot,bounty,predation" --peers "127.0.0.1:8821" --state /home/etl/.local/state/thegrid-rot2/colony.pkl
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/etl/odin/thegrid-rot2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/etl/.local/state/thegrid-rot2
MemoryMax=1536M
MemoryHigh=1024M
MemorySwapMax=0
CPUQuota=100%
CPUWeight=100

[Install]
WantedBy=default.target
