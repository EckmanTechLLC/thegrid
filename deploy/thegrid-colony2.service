[Unit]
Description=The Grid colony two experimental computational habitat
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/etl/odin/thegrid-colony2
ExecStart=/home/etl/odin/thegrid-worktree/.venv/bin/python -m src.colony.live --host 0.0.0.0 --port 8788 --ticks-per-second 10 --mutator random --state /home/etl/.local/state/thegrid-colony2/colony.pkl
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/etl/odin/thegrid-colony2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/etl/.local/state/thegrid-colony2
MemoryMax=192M
MemoryHigh=176M
MemorySwapMax=0
CPUQuota=5%
CPUWeight=10

[Install]
WantedBy=default.target
